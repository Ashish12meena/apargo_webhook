# =====================================================================================
# webhook-service — environment variables (generated from application*.yml; keep in sync)
#
#   cp .env.example .env        then uncomment ONLY what you need to change.
#
# Precedence, highest first: real environment variables > ./.env > ../platform.env >
# the defaults in application*.yml (shown below). A commented line keeps its default.
# NEVER write an empty value (VAR=): an empty value REPLACES the default with "".
# No inline comments: in this format '#' starts a comment only at the start of a line.
# .env is git-ignored; never commit real values. See docs/configuration in the platform docs.
# =====================================================================================

# ---- Profile -------------------------------------------------------------------------------
# Path of the shared platform.env (default ../platform.env, relative to the working directory).
# APARGO_PLATFORM_ENV=../platform.env

# ---- Shared infrastructure — normally set ONCE in ../platform.env; set here only to override for this service ---
# Redis host.
# REDIS_HOST=146.88.24.113
# Redis port.
# REDIS_PORT=6379
# Kafka brokers, host:port[,host:port].
# KAFKA_BOOTSTRAP_SERVERS=146.88.24.113:9092
# WEBHOOK_SERVICE_PORT=8090
# Eureka server URL.
# EUREKA_DEFAULT_ZONE=http://146.88.24.113:8761/eureka/

# ---- Internal API auth and encryption — disabled for now, ready to enable ------------------
# INTERNAL_API_KEY=<secret>
# INTERNAL_API_KEY_HEADER=X-Internal-Api-Key

# ---- Other secrets (this service only) -----------------------------------------------------
# MONGO_URI=<secret>
# Redis password.
# REDIS_PASSWORD=<secret>
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=<secret>
# WHATSAPP_APP_SECRET=<secret>

# ---- Service settings ----------------------------------------------------------------------
# BANNER_MODE=console
# SHUTDOWN_TIMEOUT=30s
# SCHEDULER_POOL_SIZE=4
# MAX_IN_MEMORY_SIZE=3MB
# REDIS_TIMEOUT=1000ms
# REDIS_CONNECT_TIMEOUT=1000ms
# REDIS_POOL_MAX_ACTIVE=16
# REDIS_POOL_MAX_IDLE=8
# REDIS_POOL_MIN_IDLE=1
# KAFKA_RETRIES=5
# KAFKA_COMPRESSION_TYPE=snappy
# KAFKA_BATCH_SIZE=65536
# KAFKA_BUFFER_MEMORY=67108864
# KAFKA_MAX_IN_FLIGHT=5
# KAFKA_DELIVERY_TIMEOUT_MS=120000
# KAFKA_REQUEST_TIMEOUT_MS=30000
# KAFKA_LINGER_MS=20
# KAFKA_MAX_BLOCK_MS=5000
# HTTP port for this service only; normally the port comes from <NAME>_SERVICE_PORT in ../platform.env.
# SERVER_PORT=8090
# MAX_HTTP_HEADER_SIZE=16KB
# TOMCAT_MAX_POST_SIZE=3MB
# TOMCAT_MAX_SWALLOW_SIZE=4MB
# TOMCAT_CONNECTION_TIMEOUT=20s
# WEBHOOK_SIGNATURE_HEADER=X-Hub-Signature-256
# WEBHOOK_VERIFY_SIGNATURE=false
# WEBHOOK_MAX_PAYLOAD_SIZE=3MB
# WEBHOOK_DEDUPE_TTL=24h
# WEBHOOK_INGEST_BATCH_ENABLED=false
# WEBHOOK_INGEST_BATCH_MAX_RECORDS=500
# WEBHOOK_INGEST_BATCH_MAX_BYTES=8MB
# WEBHOOK_INGEST_BATCH_MAX_WAIT=50ms
# WEBHOOK_PUBLISHER_FAST_PATH=true
# WEBHOOK_PUBLISHER_MAX_IN_FLIGHT=20000
# WEBHOOK_PUBLISHER_ACK_FLUSH_SIZE=1000
# WEBHOOK_PUBLISHER_ACK_FLUSH_INTERVAL=500ms
# WEBHOOK_RELAY_ENABLED=true
# WEBHOOK_RELAY_POLL_INTERVAL=500ms
# WEBHOOK_RELAY_BATCH_SIZE=1000
# WEBHOOK_RELAY_GRACE=30s
# WEBHOOK_RELAY_LEASE=30s
# WEBHOOK_RELAY_LEASE_RECLAIM_INTERVAL=30s
# WEBHOOK_RELAY_MAX_ATTEMPTS=10
# WEBHOOK_RELAY_BACKOFF_BASE=1s
# WEBHOOK_RELAY_BACKOFF_MAX=5m
# WEBHOOK_RELAY_METRICS_INTERVAL=30s
# TOPIC_INBOUND=whatsapp.webhook.inbound
# TOPIC_STATUS=whatsapp.webhook.status
# TOPIC_TEMPLATE=whatsapp.webhook.template
# TOPIC_ACCOUNT=whatsapp.webhook.account
# TOPIC_USER_PREFERENCE=whatsapp.webhook.user-preference
# TOPIC_UNROUTED=whatsapp.webhook.unrouted
# KAFKA_TOPIC_AUTO_CREATE=true
# KAFKA_TOPIC_REPLICAS=1
# PARTITIONS_INBOUND=6
# PARTITIONS_STATUS=12
# PARTITIONS_TEMPLATE=3
# PARTITIONS_ACCOUNT=3
# PARTITIONS_USER_PREFERENCE=3
# PARTITIONS_UNROUTED=1
# WEBHOOK_EVENT_TTL=30d
# Register with Eureka.
# EUREKA_ENABLED=false
# Register this instance in Eureka.
# EUREKA_REGISTER_WITH_EUREKA=true
# Fetch the Eureka registry.
# EUREKA_FETCH_REGISTRY=true
# Register with the IP address instead of the hostname.
# EUREKA_PREFER_IP_ADDRESS=true
# EUREKA_LEASE_RENEWAL=10
# Actuator endpoints exposed over HTTP, comma-separated.
# MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus,loggers
# Health details: never | when-authorized | always.
# MANAGEMENT_HEALTH_DETAILS=when_authorized
# Root log level.
# LOG_LEVEL_ROOT=INFO
# Log level of this service's own packages.
# LOG_LEVEL_APP=DEBUG
# LOG_LEVEL_RELAY=INFO
# LOG_LEVEL_KAFKA=WARN
# LOG_LEVEL_MONGO=WARN
# LOG_LEVEL_EUREKA=WARN

# ---- Older names — still honoured as fallbacks, use the new name instead -------------------
# EUREKA_REGISTER  ->  use EUREKA_REGISTER_WITH_EUREKA
# EUREKA_SERVICE_URL  ->  use EUREKA_DEFAULT_ZONE
# EUREKA_PREFER_IP  ->  use EUREKA_PREFER_IP_ADDRESS
# ACTUATOR_EXPOSE  ->  use MANAGEMENT_ENDPOINTS
# HEALTH_SHOW_DETAILS  ->  use MANAGEMENT_HEALTH_DETAILS
